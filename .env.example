DB_NAME=college_placement_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Set True in production only if your trusted host proxy overwrites X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False

# Student password resets print to the runserver terminal locally; set SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=placement-office@example.edu
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Optional, on-demand AI coaching (metrics only; never add student identifiers here).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Backups and private resumes stay outside public static/media URLs.
BACKUP_DIR=backups
PRIVATE_MEDIA_ROOT=private_media
